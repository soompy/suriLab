# Environment variables for SuriBlog
# Copy this file to .env and fill in your actual values.
# Never commit real secrets, passwords, or production database URLs.

# Database Configuration
# Neon/Supabase/PostgreSQL Database URL
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"

# Blog Administration
# Server-only password. Use a secure value in production.
BLOG_ADMIN_PASSWORD="your_secure_password_here"

# JWT Secret Key for secure authentication
# Generate a long random value for production.
JWT_SECRET="your_jwt_secret_key_here_make_it_long_and_random"

# Email Configuration
EMAIL_USER="your_email@example.com"
EMAIL_PASS="your_app_password"

# Site URL
# Used for canonical URLs, sitemap, robots, RSS, Open Graph, and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://suri-blog.vercel.app"

# Google Search Console
# Use the content value from the HTML tag verification method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="google-site-verification-token"

# Google Analytics 4
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Optional: Prisma query logs
# Set to true only when debugging database queries.
PRISMA_QUERY_LOG="false"
